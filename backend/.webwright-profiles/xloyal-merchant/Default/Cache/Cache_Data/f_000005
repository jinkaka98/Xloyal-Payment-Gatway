  .custom-checkbox {
    position: relative;
    width: 24px;
    max-width: 24px;
    height: 24px;
    max-height: 24px;
    appearance: none;
    border: 1px solid #b4b4b4;
    border-radius: 4px;
    background: #fff;
    transition: background-color 0.3s;
  }
  .custom-checkbox::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background: #fff;
  }
  .custom-checkbox:checked::before {
    background-color: #04b200;
    content: "✓";
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    text-align: center;
    line-height: 24px;
    width: 24px;
    max-width: 24px;
    height: 24px;
    max-height: 24px;
