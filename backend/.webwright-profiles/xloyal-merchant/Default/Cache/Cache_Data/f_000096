function validMail(a) {
    var re = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
    var symbolsRegex = /[+\-*&^%$#!`~={}:;'"<,>/?]/;
    if (symbolsRegex.test(a)) {
        return false;
    }    
    return re.test(a);
}

