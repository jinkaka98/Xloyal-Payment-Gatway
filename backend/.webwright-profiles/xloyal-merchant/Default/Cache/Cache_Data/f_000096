let quotesData = [];
const gambarDiv = document.getElementsByClassName('list-gambar')[0];
const kontenDiv = document.getElementById('konten');

function renderQuote(index) {
    // Kosongkan elemen gambar dan konten
    gambarDiv.innerHTML = '';
    kontenDiv.innerHTML = '';

    // Tampilkan gambar dan konten dari index yang diberikan
    const value = quotesData[index];
    const img = document.createElement('img');
    img.src = value.image;
    img.alt = value.title;
    img.className = 'img-fluid mb-2'; // Kelas bootstrap untuk responsif
    gambarDiv.appendChild(img);

    const content = document.createElement('div');
    content.innerHTML = `<h5 class="mb-4">${value.title}</h5><p>${value.description}</p>`;
    kontenDiv.appendChild(content);
}

// Fungsi untuk menavigasi ke quote berikutnya
function nextQuote() {
    if (currentIndex < quotesData.length - 1) {
        currentIndex++;
        numberIndex++;
        $("#c-list").text(numberIndex);
        $('.quotes').attr('data-quotes', currentIndex);
        renderQuote(currentIndex);
    }
}

// Fungsi untuk menavigasi ke quote sebelumnya
function prevQuote() {
    if (currentIndex > 0) {
        currentIndex--;
        numberIndex--;
        $("#c-list").text(numberIndex);
        $('.quotes').attr('data-quotes', currentIndex);
        renderQuote(currentIndex);
    }
}

function downloadQuotes(w){
    Swal.showLoading();
    var y = $(w).attr('data-quotes');
    if(y == ""){
        var imageUrl = $(w).attr('data-images');
    }else{
        var imageUrl = quotesData[y].image; // Ambil URL gambar dari JSON
    }
    const proxyUrl = path+'proses.php?required=download-quotes&file=' + encodeURIComponent(imageUrl)
    
    fetch(proxyUrl,{
        method: 'GET',
        headers: {
            'X-TOKEN-CSRF': CSRF_TOKEN,
            'X-ORIGIN': 'https://merchant.qris.online',
        }
    })
    .then(response => {
        if (!response.ok){
            Swal.fire({
                icon: "warning",
                title: "Periksa Kembali",
                html: "Tidak dapat mendownload konten, silahkan muat ulang halaman dan coba lagi.",
                confirmButtonColor: '#da2827',
                timer: 5000
            });
            return false;
        }
        return response.blob(); // Mengembalikan data gambar sebagai blob
    })
    .then(blob => {
        Swal.close();
        const url = window.URL.createObjectURL(blob);
        
        // Buat link elemen <a> secara dinamis
        const link = document.createElement('a');
        link.href = url;
        link.download = 'images-quotes'+y+'.jpg'; // Nama file yang akan diunduh

        // Simulasikan klik pada link untuk mengunduh
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        // Hapus URL object setelah digunakan
        window.URL.revokeObjectURL(url);
    })
    .catch(error => console.error('Error downloading the image '));
}

