                'X-TOKEN-CSRF': CSRF_TOKEN,
                'X-ORIGIN': 'https://merchant.qris.online',
            },
            beforeSend : function(){
                Swal.fire({
                    title: "Harap Menunggu",
                    html: "Permintaan anda sedang kami proses",
                    showCancelButton: false,
                    showConfirmButton: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            },
            complete: function(json, textStatus, xhr) {
                Swal.close();
                if (!json.responseJSON || !json.responseJSON.status) {
                    Swal.fire({
                        icon: "warning",
                        title: "Periksa Kembali",
                        html: "Terjadi kesalahan pada server atau koneksi internet anda terputus. Silakan coba lagi nanti.",
                        confirmButtonColor: '#da2827',
                        timer: 5000
                    });
                    return false;
                }

                if(json.responseJSON.status == "failed" || json.responseJSON.status == "already"){
                    if(json.responseJSON.status == "already"){
                        $('#modal-confirm-sending').modal('hide');
                    }
                    Swal.fire({
                        icon: "warning",
                        title: "Periksa Kembali",
                        html: json.responseJSON.message,
                        confirmButtonColor: '#da2827',
                        timer:5000
                    });    
                    return false;
                }
                $('#modal-confirm-sending').modal('hide');
                Swal.fire({
                    icon: "success",
                    title: "Sukses",
                    html: json.responseJSON.message,
                    confirmButtonColor: '#da2827',
                    timer:5000
                });
            },
            error: function (jqXHR, textStatus, errorThrown){
                Swal.close();
                Swal.fire({
                    icon:"error",
                    title: "Periksa Kembali",
                    html: "Gagal Mengirim Data Pengajuan Klaim. Mohon Ulangi Kembali",
                    confirmButtonColor: '#da2827',
                    timer:5000
                });
            }
        });
    });

