                btn.removeAttribute('onclick');
                btn.setAttribute('href', json.responseJSON.url);
                btn.innerText = "Lanjutkan Aktivasi QRIS";
                return false;
            }

            if (json.responseJSON.status == "failed") {
                $("#cancelAktifasi").hide();
                $("#reactivated").show();
