function filterItems() {
    var input = document.getElementById('searchInput');
    var filter = input.value.toUpperCase(); // Ubah input ke uppercase agar pencarian case-insensitive
    var ul = document.getElementById("databank");
    var li = ul.getElementsByTagName('li');

    // Loop dimulai dari index 1 karena index 0 adalah input pencarian
    for (var i = 1; i < li.length; i++) {
        var a = li[i].querySelector("a"); // Ambil elemen <a> dalam setiap <li>
        if (a) {
            var dataJenis = a.getAttribute("data-jenis"); // Ambil atribut data-jenis
            if (dataJenis && dataJenis.toUpperCase().indexOf(filter) > -1) {
                li[i].style.display = ""; // Tampilkan jika sesuai
            } else {
                li[i].style.display = "none"; // Sembunyikan jika tidak sesuai
            }
        }
    }
}


function maskEmailOrWhatsapp(email) {
    // Pisahkan email menjadi nama pengguna dan domain
    var parts = email.split('@');
    var username = parts[0];
    if(parts[1] == undefined){ // whatsapp
        var maskedPhone = email.substring(1, 4);
        var maskedPhonex = '*'.repeat(email.length - 8) + email.substring(email.length - 2);
        // var maskedPhone = email.substring(0, 2) + '*'.repeat(email.length - 3) + email.substring(email.length - 0);
        var masked = "+62 "+maskedPhone+'-'+maskedPhonex;
    }else{
        var domain = parts[1];
        var maskLength = Math.max(0, username.length - 3);
        var maskedUsername = username.substring(0, 2) + '*'.repeat(maskLength) + username.substring(username.length - 0);
        var masked = maskedUsername + '@' + domain;
    }

    return masked;
}

let isCountdownOTPRunning = false;
function getCountDownOTP(endTime){
    var endTimee      = new Date(endTime).getTime();
    var currentTime   = new Date().getTime();
    var remainingTime = endTimee - currentTime;
    if(remainingTime > 0){
        isCountdownOTPRunning = true;
        // Calculate days, hours, minutes, and seconds
        var minutes = Math.floor((remainingTime % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((remainingTime % (1000 * 60)) / 1000);
        minutes = minutes < 10 ? "0" + minutes : minutes;
        seconds = seconds < 10 ? "0" + seconds : seconds;
        // Display the countdown
        var cd = document.getElementById('otpcountdown');
        if(cd){
            document.getElementById('otpcountdown').innerHTML = minutes + ':' + seconds;
        }
    }else{
        $("#otpcountdown").text("00:00");
        isCountdownOTPRunning = false;
        clearInterval(intervalId4);
    }
}

