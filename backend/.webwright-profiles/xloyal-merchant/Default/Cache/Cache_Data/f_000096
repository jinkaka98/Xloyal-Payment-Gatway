    // ── Helper validasi ──
    function validateField(id, errId, validatorFn) {
        const el  = document.getElementById(id);
        const err = document.getElementById(errId);
        const ok  = validatorFn(el.value.trim());
        el.classList.toggle('is-error', !ok);
        err.classList.toggle('show', !ok);
        return ok;
    }
    
    const notEmpty = v => v.length > 0;
    const validWa  = v => /^(\+62|62|0)[0-9]{9,13}$/.test(v.replace(/\s/g, ''));
    const validPos = v => /^[0-9]{5}$/.test(v);

    // ── Live validation on blur ──
    document.getElementById('namaPenerima').addEventListener('blur',  () => validateField('namaPenerima', 'errNama',     notEmpty));
    document.getElementById('nomorWa')    .addEventListener('blur',  () => validateField('nomorWa',      'errWa',       validWa));
    document.getElementById('provinsi')   .addEventListener('change',() => validateField('provinsi',     'errProvinsi', notEmpty));
    document.getElementById('kabupatenkota')  .addEventListener('blur',  () => validateField('kabupatenkota', 'errKota',     notEmpty));
    document.getElementById('alamat')     .addEventListener('blur',  () => validateField('alamat',       'errAlamat',   notEmpty));
    document.getElementById('kodePos')    .addEventListener('blur',  () => validateField('kodePos',      'errKodePos',  validPos));

    // Hanya angka untuk kodePos
    document.getElementById('kodePos').addEventListener('input', function() {
    this.value = this.value.replace(/\D/g, '');
    });

    // Hanya angka & + untuk nomorWa
    document.getElementById('nomorWa').addEventListener('input', function() {
    this.value = this.value.replace(/[^0-9+\s]/g, '');
    });

    // ── Submit ──
    document.getElementById('formAkrilik').addEventListener('submit', function(e) {
        e.preventDefault();
    
        let isValid = true;

        document.getElementById('errKota').classList.remove('show');
    
        // Validasi akrilik
        if (!selectedAkrilik) {
          document.getElementById('errorAkrilik').classList.add('show');
          isValid = false;
        }
    
        // Validasi semua field
        if (!validateField('namaPenerima', 'errNama',     notEmpty)) isValid = false;
        if (!validateField('nomorWa',      'errWa',       validWa))  isValid = false;
        if (!validateField('alamat',       'errAlamat',   notEmpty)) isValid = false;
        if (!validateField('kodePos',      'errKodePos',  validPos)) isValid = false;

        if (!document.getElementById('provinsi').value) {
            document.getElementById('errProvinsi').classList.add('show');
            isValid = false;
        } else {
            document.getElementById('errProvinsi').classList.remove('show');
        }
        
        if (!document.getElementById('kabupatenkota').value) {
            document.getElementById('errKota').classList.add('show');
            isValid = false;
        } else {
            document.getElementById('errKota').classList.remove('show');
        }
    
        if (!isValid) {
          // Scroll ke error pertama
          const firstErr = document.querySelector('.is-error, .akrilik-error.show');
          if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
    
        // ── Semua valid → kumpulkan data ──
        const data = {
          jenis_akrilik : selectedAkrilik,
          nama_penerima : document.getElementById('namaPenerima').value.trim(),
          nomor_wa      : document.getElementById('nomorWa').value.trim(),
          provinsi      : document.getElementById('provinsi').value,
          kota          : document.getElementById('kabupatenkota').value.trim(),
          alamat        : document.getElementById('alamat').value.trim(),
          kode_pos      : document.getElementById('kodePos').value.trim(),
          catatan       : document.getElementById('catatan').value.trim(),
        };
    
        window._dataPengiriman = data;

        // Isi modal konfirmasi
        const imgMap = { standing: 'assets-v2/images/acrylic-standing.png', tempel: 'assets-v2/images/acrylic-tempel.png' };
        const labelMap = { standing: 'Akrilik Standing', tempel: 'Akrilik Tempel' };
        
        document.getElementById('konfirmasiImgAkrilik').src   = imgMap[data.jenis_akrilik] || '';
        document.getElementById('konfirmasiLabelAkrilik').textContent = labelMap[data.jenis_akrilik] || '';
        document.getElementById('konfNama').textContent       = data.nama_penerima;
        document.getElementById('konfWa').textContent         = data.nomor_wa;
        document.getElementById('konfAlamat').textContent     = data.alamat;
        document.getElementById('konfProvinsi').textContent   = data.provinsi;
        document.getElementById('konfKota').textContent       = data.kota;
        document.getElementById('konfKodePos').textContent    = data.kode_pos;
        document.getElementById('konfCatatan').textContent    = data.catatan || '-';
        
        // Tutup modal form (jika ada), buka modal konfirmasi
        $('#modalKonfirmasi').modal('show');
      });
