            if(res && res.success){
              $('#wl_domain').val(res.domain || domain);
              wlSetStatus('Domain tersimpan: '+(res.domain || domain), false);
            }else{
              wlSetStatus(res && res.message ? res.message : 'Gagal simpan domain.', true);
            }
