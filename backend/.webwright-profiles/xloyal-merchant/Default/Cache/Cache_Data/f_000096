function predictKeywordWilayah(keywordPredictedId, keywordListLocationId, predictionListLocationId) {
    
    const userInput = document.getElementById(keywordPredictedId).value.toLowerCase();
    const keywordList = document.getElementById(keywordListLocationId);
    const predictionList = document.getElementById(predictionListLocationId);
    predictionList.innerHTML = '';
    // const matchingKeywords = Array.from(keywordList.getElementsByTagName('li')).filter(li => li.dataset.wilayah.toLowerCase().includes(userInput));
    const matchingKeywords = Array.from(keywordList.getElementsByTagName('li')).filter(li => {
        const wilayah = li.getAttribute('data-wilayah');
        return wilayah && wilayah.toLowerCase().includes(userInput);
    });
    if (matchingKeywords.length > 0) {
        keywordList.style.display = 'none';
        predictionList.style.display = 'block';
        matchingKeywords.forEach(keyword => {
            const clonedItem = keyword.cloneNode(true);            
            predictionList.appendChild(clonedItem);
        });
    } else {        
        predictionList.style.display = 'none';
    }
}

