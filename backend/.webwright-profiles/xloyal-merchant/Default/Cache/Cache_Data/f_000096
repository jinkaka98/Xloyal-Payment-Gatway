    $(document).on('click', '.btn-detail-log', function(){
        var raw = $(this).data('log');
        if (!raw) return;
        var log = (typeof raw === 'object') ? raw : JSON.parse(raw);

        $('#log-invoice').text('Invoice: ' + (log.invoice || '-'));

        if (log.mode === 'init') {
            $('#log-section-init').show();
            $('#log-section-webhook').hide();
            $('#log-trx-json').text(JSON.stringify(log.trx || {}, null, 2));
        } else {
            $('#log-section-init').hide();
            $('#log-section-webhook').show();

            $('#log-sent-at').text(log.sent_at || '-');
            $('#log-response-at').text(log.response_at || '-');

            try {
                var payloadObj = log.payload ? JSON.parse(log.payload) : null;
                $('#log-payload').text(payloadObj ? JSON.stringify(payloadObj, null, 2) : (log.payload || '-'));
            } catch(e) {
                $('#log-payload').text(log.payload || '-');
            }

            try {
                var respObj = log.response ? JSON.parse(log.response) : null;
                $('#log-response').text(respObj ? JSON.stringify(respObj, null, 2) : (log.response || '-'));
            } catch(e) {
                $('#log-response').text(log.response || '-');
            }

            $('#log-last-error').text(log.last_error || '-');
        }

        var modal = new bootstrap.Modal(document.getElementById('modalDetailLog'));
        modal.show();
    });

