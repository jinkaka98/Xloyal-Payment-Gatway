function checkData(){
    $.ajax({
        url      : path+'proses.php?required=check-qris-activ',
        method   : "GET",
        dataType : "json",
        headers: {
            'X-TOKEN-CSRF': CSRF_TOKEN,
            'X-ORIGIN': 'https://merchant.qris.online',
        },
        beforeSend: function(){
            $("#cancelAktifasi").hide();
            $("#gone").hide();
            $("#load-data").show();
            $("#reactivated").hide();
            $("#confirmReactivated").hide();
            $("#rejectActivated").hide();
            $("#welcomeHome").hide();
        },
        complete: function(json, textStatus, xhr) {
            $("#load-data").hide();
            if (!json.responseJSON || !json.responseJSON.status) {
                Swal.fire({
                    icon: "warning",
                    title: "Periksa Kembali",
                    html: "Terjadi kesalahan pada server atau koneksi internet anda terputus. Silakan coba lagi.",
