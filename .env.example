POSTGRES_DB=xloyal
POSTGRES_USER=xloyal
POSTGRES_PASSWORD=change-me
HTTP_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Generate with: openssl rand -base64 32 | tr -d '='
CREDENTIAL_ENCRYPTION_KEY=replace-with-unpadded-base64-32-byte-key
# Map opaque bearer tokens to viewer, operator, or super_admin.
ADMIN_TOKENS_JSON={"replace-admin-token":"super_admin"}
ADMIN_API_TOKEN=replace-admin-token
ADMIN_CONSOLE_EMAIL=admin@xloyal.id
ADMIN_CONSOLE_PASSWORD=replace-with-a-long-random-password
CONSOLE_SESSION_SECRET=replace-with-at-least-32-random-characters
CONSOLE_COOKIE_SECURE=false
NEXT_PUBLIC_USE_MOCK_API=false
# Shared only by the worker bridge and the private camofox-browser service.
CAMOFOX_BROWSER_API_KEY=replace-with-a-long-random-browser-key
# Mount a deployment secret at this path; its content is email then password.
CAMOUFOX_CREDENTIAL_FILE=/run/secrets/interactive_qris_credentials

