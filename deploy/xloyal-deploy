#!/bin/sh
set -eu
exec 9>/run/lock/xloyal-deploy.lock
flock -n 9 || exit 0
. /DATA/AppData/xloyal/github.env
# This repository is public.  Fetching anonymously avoids stale PATs in the
# server environment turning an otherwise valid update into an auth failure.
unset GITHUB_TOKEN GIT_ASKPASS SSH_ASKPASS
export GIT_TERMINAL_PROMPT=0
repo=/DATA/projects/xloyal/current
compose=/var/lib/casaos/apps/xloyal/docker-compose.yml
signal=/DATA/AppData/xloyal/signals/deploy-request
cd "$repo"
previous=$(git rev-parse HEAD)
git -c credential.helper= fetch --quiet origin main
requested=$(cat "$signal" 2>/dev/null || true)
target=$(git rev-parse origin/main)
if [ -n "$requested" ] && [ "$requested" != "$target" ]; then
  echo "webhook commit is not origin/main; deploying current main" >&2
fi
git checkout --detach --quiet "$target"
if docker compose -f "$compose" up -d --build --remove-orphans && \
  curl -fsS --max-time 15 http://127.0.0.1:1970/v1/health >/dev/null && \
  curl -fsS --max-time 15 http://127.0.0.1:5656/ >/dev/null; then
  printf '%s\n' "$target" > /DATA/AppData/xloyal/deployed-commit
  rm -f "$signal"
  exit 0
fi
git checkout --detach --quiet "$previous"
docker compose -f "$compose" up -d --build --remove-orphans
exit 1
