ADMIN_CONSOLE_PASSWORD=replace-with-long-random-password
CONSOLE_SESSION_SECRET=replace-with-at-least-32-random-characters
CONSOLE_COOKIE_SECURE=true
NEXT_PUBLIC_API_URL=https://api.alpakyros.net
NEXT_PUBLIC_USE_MOCK_API=false
